# ===== 运行模式 =====
# 留空 = 演示模式（内置种子数据，无需任何密钥即可运行）
# 填入腾讯云开发 CloudBase 环境 ID 后自动切换真实后端（数据库+匿名登录+云函数+COS）
VITE_TCB_ENV_ID=your-env-id
# 云函数 adminApi 的 HTTP 网关地址（见 README 第六节）
VITE_ADMIN_API_URL=https://<your-env-domain>/adminApi
# 老云存储桶名（历史媒体）与 COS 付费桶（新媒体）
VITE_TCB_STORAGE_BUCKET=mzzx
VITE_COS_BUCKET=your-cos-bucket
VITE_COS_REGION=ap-beijing

# ===== 演示模式管理员账号 =====
VITE_DEMO_ADMIN_USER=admin
VITE_DEMO_ADMIN_PASS=mzzx2027

# 真实模式的管理员密码在云函数 adminApi 的环境变量 ADMIN_PASS 中配置（不要放前端）